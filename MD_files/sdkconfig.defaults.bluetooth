# ESP32 Bluetooth Template Configuration
# Copy this file to your new project root as "sdkconfig.defaults"
# or append these settings to an existing sdkconfig.defaults file

#
# Bluetooth Configuration
#
CONFIG_BT_ENABLED=y

# Bluetooth Stack Selection
CONFIG_BT_BLUEDROID_ENABLED=y
# CONFIG_BT_NIMBLE_ENABLED is not set

# Bluetooth Controller
CONFIG_BT_CONTROLLER_ENABLED=y

#
# Bluedroid Options
#
CONFIG_BT_BTC_TASK_STACK_SIZE=3072
CONFIG_BT_BLUEDROID_PINNED_TO_CORE=0
CONFIG_BT_BTU_TASK_STACK_SIZE=4352
CONFIG_BT_BLUEDROID_ESP_COEX_VSC=y

# BLE (Bluetooth Low Energy)
CONFIG_BT_BLE_ENABLED=y

# BLE Features
# Enable BLE 4.2 features (required for standard advertising APIs)
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y

# GATT Server
CONFIG_BT_GATTS_ENABLE=y
CONFIG_BT_GATT_MAX_SR_PROFILES=8
CONFIG_BT_GATT_MAX_SR_ATTRIBUTES=100
CONFIG_BT_GATTS_SEND_SERVICE_CHANGE_AUTO=y
CONFIG_BT_GATTS_SEND_SERVICE_CHANGE_MODE=0

# GATT Client
CONFIG_BT_GATTC_ENABLE=y
CONFIG_BT_GATTC_MAX_CACHE_CHAR=40
CONFIG_BT_GATTC_NOTIF_REG_MAX=5

# BLE SMP (Security Manager Protocol)
CONFIG_BT_BLE_SMP_ENABLE=y
CONFIG_BT_SMP_ENABLE=y

# Classic Bluetooth (if needed - enable these for A2DP, SPP, etc.)
# CONFIG_BT_CLASSIC_ENABLED=y
# CONFIG_BT_A2DP_ENABLE=y
# CONFIG_BT_SPP_ENABLED=y

# Controller Configuration
CONFIG_BT_CTRL_BLE_MAX_ACT=10
CONFIG_BT_CTRL_BLE_STATIC_ACL_TX_BUF_NB=0

# Memory Configuration
# Adjust these based on your application needs
# CONFIG_BT_ALLOCATION_FROM_SPIRAM_FIRST is not set

# Coexistence (WiFi + BT)
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
CONFIG_ESP_WIFI_SW_COEXIST_ENABLE=y
